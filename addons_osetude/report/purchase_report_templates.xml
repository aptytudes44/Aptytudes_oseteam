<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_inherit" inherit_id="purchase.report_purchaseorder_document">
        <!-- Nom du compte analytique à côté du n° de commande dans le titre -->
        <xpath expr="//t[@t-set='layout_document_title']//span[@t-field='o.name']" position="after">
            <span t-if="o.account_analytic_id"> / </span><span t-if="o.account_analytic_id" t-field="o.account_analytic_id.name"/>
        </xpath>

        <!-- v17 : target only thead (replacing full table loses tbody) -->
        <xpath expr="//table[contains(@class,'o_main_table')]/thead" position="replace">
            <thead>
                <tr>
                    <th name="th_analytic"><span>Analytic</span></th>
                    <th name="th_description"><span>Description</span></th>
                    <th class="text-center" name="th_date_planned"><span>Date Req.</span></th>
                    <th class="text-end" name="th_qty"><span>Qty</span></th>
                    <th class="text-end" name="th_unit"><span>Unit</span></th>
                    <th class="text-end" name="th_priceunit"><span>Unit Price</span></th>
                    <th class="text-end" name="th_discount"><span>Disc.</span></th>
                    <th class="text-end" name="th_taxes"><span>Taxes</span></th>
                    <th class="text-end" name="th_subtotal"><span>Subtotal</span></th>
                </tr>
            </thead>
        </xpath>

        <!-- Colonne Compte analytique par ligne -->
        <xpath expr="//td[@id='product']" position="before">
            <td>
                <span t-field="line.analytic_account_display_name"/>
            </td>
        </xpath>

        <!-- Colonne Date demandée par ligne -->
        <xpath expr="//td[span[@t-field='line.product_qty']]" position="before">
            <td class="text-center">
                <span t-field="line.date_planned" t-options="{'widget': 'date'}"/>
            </td>
        </xpath>

        <!-- Information fournisseur sur l'impression du bon de commande -->
        <xpath expr="//table[hasclass('o_main_table')]" position="before">
            <p t-if="o.partner_ref_note">
                <b><i>Partner Information: </i></b><b><i><span t-field="o.partner_ref_note" style="color:red"/></i></b>
                <br/>
            </p>
        </xpath>

        <!-- Dossier technique -->
        <xpath expr="//div[hasclass('page')]" position="after">
            <span t-if="o.print_technical_document == true">
                <p style="page-break-before:always;"><span t-out="o.technical_document"/></p>
            </span>
        </xpath>
    </template>

    <template id="report_purchasequotation_document_inherit" inherit_id="purchase.report_purchasequotation_document">
        <!-- Nom du compte analytique à côté du n° de la demande de prix -->
        <xpath expr="//t[@t-set='layout_document_title']//span[@t-field='o.name']" position="after">
            <span t-if="o.account_analytic_id"> / </span><span t-if="o.account_analytic_id" t-field="o.account_analytic_id.name"/>
        </xpath>

        <!-- Colonne Compte analytique par ligne -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_analytic"><strong>Analytic</strong></th>
        </xpath>
        <xpath expr="//td[@id='product']" position="before">
            <td>
                <span t-field="order_line.analytic_account_display_name"/>
            </td>
        </xpath>

        <!-- Dossier technique -->
        <xpath expr="//div[hasclass('page')]" position="after">
            <span t-if="o.print_technical_document == true">
                <p style="page-break-before:always;"><span t-out="o.technical_document"/></p>
            </span>
        </xpath>
    </template>
</odoo>
