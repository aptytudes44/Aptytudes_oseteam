<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nom du fichier PDF = uniquement le numéro du BL (ex: OSE-L-260462.pdf).
         print_report_name est un champ traduit (stocké par langue) : il faut
         l'écrire explicitement pour fr_FR, sinon seule la valeur en_US change
         et la traduction française existante (non identique) reste inchangée. -->
    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="print_report_name">object.name</field>
    </record>
    <record id="stock.action_report_delivery" model="ir.actions.report" context="{'lang': 'fr_FR'}">
        <field name="print_report_name">object.name</field>
    </record>

    <template id="report_delivery_document_inherit_sale_stock_inherit" inherit_id="stock.report_delivery_document">
        <!-- Cartouche : référence client, projet, note -->
        <xpath expr="//h2" position="before">
            <div id="custom_informations">
                <div t-if="o.sale_id">
                    <strong>Customer Reference: </strong><span t-field="o.sale_id.client_order_ref"/>
                </div>
                <div t-if="o.project_id">
                    <strong>Project: </strong><span t-field="o.project_id.name"/>
                </div>
                <div t-if="o.project_id and o.project_id.title_project">
                    <strong>Project reference: </strong><span t-field="o.project_id.title_project"/>
                </div>
                <div t-if="o.delivery_note">
                    <strong>Note: </strong><span t-field="o.delivery_note"/>
                </div>
                <br/>
            </div>
        </xpath>

        <!-- Libellé "Delivery form #" / "Receipt #" devant le nom du document -->
        <xpath expr="//h2/span[@t-field='o.name']" position="before">
            <t t-if="o.picking_type_code=='outgoing'">Delivery form # </t>
            <t t-if="o.picking_type_code=='incoming'">Receipt # </t>
        </xpath>

        <!-- Mention réclamations sous 15 jours (bons de livraison sortants) -->
        <xpath expr="//div[hasclass('page')]" position="inside">
            <div style="font-size: 13px;" t-if="o.picking_type_code=='outgoing'">
                <p><i>Complaints can only be accepted within 15 days of receipt of this delivery note.</i></p>
            </div>
        </xpath>

        <!-- En-tête de colonne "Produit" -> "Description" (les 3 tableaux : brouillon, validé, backorder) -->
        <xpath expr="//th[@name='th_sm_product']" position="replace">
            <th name="th_sm_product"><strong>Description</strong></th>
        </xpath>
        <xpath expr="//th[@name='th_sml_product']" position="replace">
            <th name="th_sml_product">Description</th>
        </xpath>
        <xpath expr="//th[@name='th_sb_product']" position="replace">
            <th name="th_sb_product"><strong>Description</strong></th>
        </xpath>

        <!-- Tableau brouillon/confirmé (o.state != 'done') : ne plus imprimer le nom du produit
             quand une description distincte existe, même logique que le tableau validé. -->
        <xpath expr="//table[@name='stock_move_table']//td[1]" position="replace">
            <td>
                <span t-if="not (move.description_picking and move.description_picking != move.product_id.name and move._get_report_description_picking())" t-field="move.product_id">Customizable Desk</span>
                <p t-if="move.description_picking and move.description_picking != move.product_id.name and move._get_report_description_picking()">
                    <span t-out="move._get_report_description_picking()">Description on transfer</span>
                </p>
            </td>
        </xpath>

        <!-- Tableau "Quantités restantes non livrées" (backorders) : même logique. -->
        <xpath expr="//table[@name='stock_backorder_table']//td[1]" position="replace">
            <td class="w-auto">
                <span t-if="not (bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line._get_report_description_picking())" t-field="bo_line.product_id">Office Chair</span>
                <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line._get_report_description_picking()">
                    <span t-out="bo_line._get_report_description_picking()">Description on transfer</span>
                </p>
            </td>
        </xpath>

    </template>

    <!-- Ne plus jamais imprimer le nom du produit quand une description existe (idem factures) :
         'description' = description_picking avec le nom produit déjà retiré en préfixe par Odoo.
         Si vide (aucune description distincte), on garde le nom produit en repli. -->
    <template id="stock_report_delivery_aggregated_move_lines_inherit" inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//tr/td[1]" position="replace">
            <td>
                <span t-if="not aggregated_lines[line]['description']" t-esc="aggregated_lines[line]['name']"/>
                <span t-if="aggregated_lines[line]['description']" t-esc="aggregated_lines[line]['description']" t-options="{'widget': 'text'}"/>
            </td>
        </xpath>
    </template>

    <template id="stock_report_delivery_has_serial_move_line_inherit" inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[1]" position="replace">
            <td>
                <t t-if="not description and description != ''">
                    <t t-set="description" t-value="move_line.move_id.description_picking"/>
                </t>
                <span t-if="description == '' or description == move_line.product_id.display_name or description == move_line.product_id.name" t-field="move_line.product_id"/>
                <p t-if="description != '' and
                         description != move_line.product_id.display_name and
                         description != move_line.product_id.name"
                >
                    <span t-esc="description"/>
                </p>
            </td>
        </xpath>
    </template>
</odoo>

