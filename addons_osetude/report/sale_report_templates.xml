    <template id="report_saleorder_document_inherit" inherit_id="sale.report_saleorder_document">
        <!-- DESACTIVE (31/07/2026) : GESTION DES ADRESSES
        <xpath expr="//t[@t-set='address']" position="replace">
            <table style="width: 100%;">
                <thead>
                    <th style="width: 33%;"><div t-if="doc.partner_shipping_id != doc.partner_id">Shipping address:</div></th>
                    <th style="width: 33%;"><div t-if="doc.partner_invoice_id != doc.partner_id">Invoicing address:</div></th>
                    <th>Customer:</th>
                </thead>
                <tbody>
                    <td><div t-if="doc.partner_shipping_id != doc.partner_id" t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": true, "phone_icons": true}'/></td>
                    <td><div t-if="doc.partner_invoice_id != doc.partner_id" t-field="doc.partner_invoice_id" t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": true, "phone_icons": true}'/></td>
                    <td>
                        <div t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                        <p t-if="doc.partner_id.vat"><t t-esc="doc.company_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="doc.partner_id.vat"/></p>
                    </td>
                </tbody>
            </table>
            <br/>
        </xpath>
        -->

        <!-- REMPLACE "#" PAR "N°" DANS LE TITRE (Devis N°/Commande N°/Facture Pro forma N°) -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="is_proforma">Pro-Forma Invoice No. </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation No. </span>
                <span t-else="">Order No. </span>
                <span t-field="doc.name">SO0000</span>
            </t>
        </xpath>

        <!-- Masque le "Salesperson" natif du cartouche Odoo (doublon avec notre "Vendeur :" ajouté juste en dessous) -->
        <xpath expr="//div[@id='informations']/div[@t-if='doc.user_id.name']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>

        <!-- "Echéance" (traduction native de "Expiration") -> "Date d'expiration" -->
        <xpath expr="//div[@name='expiration_date']/strong" position="replace">
            <strong>Date d'expiration</strong>
        </xpath>

        <!-- Conditions de paiement, juste apres "Date du devis"/"Date de la commande" -->
        <xpath expr="//div[@name='informations_date']" position="after">
            <div t-if="doc.payment_term_id" class="col" name="informations_payment_term">
                <strong>Conditions de paiement</strong>
                <div t-field="doc.payment_term_id"/>
            </div>
        </xpath>

        <!-- GESTION DU CARTOUCHE : ajouté APRES le cartouche standard d'Odoo (Votre référence /
             Date du devis / Echéance / Vendeur), pas en remplacement, pour garder ces champs
             natifs et compléter avec Vendeur/Contact client côte à côte, puis Affaire. Aucun
             cadre/bordure (border:none partout, comme le cartouche natif). -->
        <xpath expr="//div[@id='informations']" position="after">
            <div class="row" style="border-top: 2px solid #dde1e6; border-bottom: 2px solid #dde1e6; padding-top: 4px; padding-bottom: 4px; margin: 0;">
                <div class="col-6">
                    <div><strong>Vendeur :</strong> <span t-field="doc.user_id"/></div>
                    <div><strong>Téléphone :</strong> <span t-field="doc.user_id.phone"/></div>
                    <div><strong>Email:</strong> <span t-field="doc.user_id.partner_id.email"/></div>
                </div>
                <div class="col-6">
                    <div><strong>Contact client :</strong> <span t-field="doc.responsible_business_id"/></div>
                    <div><strong>Téléphone :</strong> <span t-field="doc.phone_responsible_business"/></div>
                    <div><strong>Email:</strong> <span t-field="doc.mail_responsible_business"/></div>
                </div>
            </div>
            <div class="row" style="margin: 8px 0 0 0;">
                <div class="col-12">
                    <div><strong>Affaire :</strong> <span t-field="doc.project_id"/></div>
                    <div><strong>Référence affaire :</strong> <span t-field="doc.project_id.title_project"/></div>
                </div>
            </div>
        </xpath>

        <!-- Répète l'entête du tableau des articles sur chaque page : Odoo force
             "display: table-row-group" sur le thead (empêche la répétition), on remet
             la valeur standard "table-header-group" qui la réactive. Ligne de séparation
             ajoutée juste avant les titres de colonnes (même style que le cartouche). -->
        <xpath expr="//table[contains(@class,'o_main_table')]/thead" position="attributes">
            <attribute name="style">display: table-header-group</attribute>
        </xpath>
        <xpath expr="//table[contains(@class,'o_main_table')]/thead/tr" position="attributes">
            <attribute name="style">border-top: 2px solid #dde1e6</attribute>
        </xpath>

        <!-- Libellés des colonnes en gras (un xpath par colonne, un xpath multi-match
             ne s'applique qu'au 1er élément trouvé en héritage de vue Odoo). Inclut aussi
             la colonne "Disc.%" qui n'apparaît que si une remise existe sur une ligne. -->
        <xpath expr="//th[@name='th_description']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>
        <xpath expr="//th[@name='th_discount']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="style">font-weight: bold</attribute>
        </xpath>

        <!-- DESACTIVE (31/07/2026) : MODIFICATION ENTETE DE LA LISTE DES ARTICLES (v17 : drop style attribute filter ; 2x TODO remove in master)
        <xpath expr="//table[contains(@class,'o_main_table')]/thead" position="replace">
            <thead>
                <tr>
                    <t t-set="colspan" t-value="5"/>
