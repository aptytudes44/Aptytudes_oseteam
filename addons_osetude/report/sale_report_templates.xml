        <!-- DESACTIVE (31/07/2026) : POUR AJOUTER LE DOSSIER TECHNIQUE
        <xpath expr="//div[hasclass('page')]" position="after">
            <span t-if="doc.print_technical_document == true">
                <p style="page-break-before:always;"><span t-out="doc.technical_document"/></p>
            </span>
        </xpath>
        -->

        <!-- DESACTIVE (31/07/2026) : POUR REDUIRE LA TAILLE DU TEXTE DES CONDITIONS
        <xpath expr="//p[@t-if='not is_html_empty(doc.payment_term_id.note)']" position="attributes">
            <attribute name="style">font-size: 12px;</attribute>
        </xpath>
        -->
    </template>

    <!-- Ajoute les colonnes Quantité et Montant total HT au tableau des produits
         optionnels du devis. -->
    <template id="report_saleorder_document_option_columns_inherit" inherit_id="sale_management.report_saleorder_document_inherit_sale_management">
        <xpath expr="//td[@name='th_option_name']" position="after">
            <td name="th_option_quantity" class="text-end">Quantité</td>
        </xpath>
        <xpath expr="//td[@name='th_option_price_unit']" position="after">
            <td name="th_option_total" class="text-end">Montant total HT</td>
        </xpath>
        <xpath expr="//td[@name='td_option_name']" position="after">
            <td name="td_option_quantity" class="text-end">
                <span t-if="not option.display_type" t-field="option.quantity"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_option_price_unit']/strong" position="replace">
            <t t-if="not option.display_type">
                <strong class="text-end">
                    <div t-field="option.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}' t-att-style="option.discount and 'text-decoration: line-through' or None" t-att-class="option.discount and 'text-danger' or None"/>
                    <div t-if="option.discount">
                        <t t-out="((1-option.discount / 100.0) * option.price_unit)" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                    </div>
                </strong>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_option_price_unit']" position="after">
            <td name="td_option_total" class="text-end">
                <strong t-if="not option.display_type">
                    <t t-out="option.quantity * option.price_unit" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                </strong>
            </td>
        </xpath>
    </template>
</odoo>
