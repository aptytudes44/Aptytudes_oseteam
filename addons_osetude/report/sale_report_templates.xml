<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Nom du fichier PDF = uniquement le numéro du devis (ex: OSE-V-260503-01.pdf).
         print_report_name est un champ traduit (stocké par langue) : il faut
         l'écrire explicitement pour fr_FR, sinon seule la valeur en_US change
         et la traduction française existante (non identique) reste inchangée. -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="print_report_name">object.name</field>
    </record>
    <record id="sale.action_report_saleorder" model="ir.actions.report" context="{'lang': 'fr_FR'}">
        <field name="print_report_name">object.name</field>
    </record>

