<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_bl_generic_inherit" model="ir.ui.view">
        <field name="name">product.template.form.bl.generic.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='internal_notes']" position="after">
                <group string="Bon de livraison" name="bl_generic_group">
                    <field name="bl_generic_product"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
