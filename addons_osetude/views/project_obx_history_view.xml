<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_project_obx_history_tree" model="ir.ui.view">
            <field name="name">project.obx.history.list</field>
            <field name="model">project.obx.history</field>
            <field name="arch" type="xml">
                <list string="Historique Projets OBX">
                    <field name="name"/>
                    <field name="ref_customer"/>
                    <field name="customer"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <record id="view_project_obx_history_form" model="ir.ui.view">
            <field name="name">project.obx.history.form</field>
            <field name="model">project.obx.history</field>
            <field name="arch" type="xml">
                <form string="Historique Projets OBX">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="description"/>
                            </group>
                            <group>
                                <field name="ref_customer"/>
                                <field name="customer"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_project_obx_history_filter" model="ir.ui.view">
            <field name="name">project.obx.history.search</field>
            <field name="model">project.obx.history</field>
            <field name="arch" type="xml">
                <search string="Recherche Projet OBX">
                    <field name="name"/>
                    <field name="ref_customer"/>
                    <field name="customer"/>
                    <field name="description"/>
                    <group expand="0" string="Grouper par">
                        <filter string="Client" name="customer" context="{'group_by':'customer'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_view_project_obx_history" model="ir.actions.act_window">
            <field name="name">Historique Projets OBX</field>
            <field name="res_model">project.obx.history</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_project_obx_history_filter"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Import Historique Projets OBX
                </p>
            </field>
        </record>

        <menuitem name="Historique OBX" id="menu_project_obx_history" action="action_view_project_obx_history" parent="project.menu_main_pm" sequence="60" groups="project.group_project_manager,project.group_project_user"/>

    </data>
</odoo>
