<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_purchase_order_filter_inherit" model="ir.ui.view">
            <field name="name">request.quotation.select</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="account_analytic_id" string="Compte Analytique"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.order.tree</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="before">
                    <field name="account_analytic_id" invisible="1"/>
                </xpath>
                <!-- Référence fournisseur déplacée après la colonne Fournisseur (partner_id) -->
                <xpath expr="//field[@name='partner_ref']" position="replace"/>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_ref" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Vue utilisée par le menu "Demandes de prix" (action purchase_rfq) -->
        <record id="purchase_order_kpis_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.order.kpis.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ref']" position="replace"/>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_ref" optional="show"/>
                </xpath>
                <!-- date_planned masqué en permanence dans cette vue (column_invisible
                     lié à quotation_only, toujours vrai ici) : on la remplace par une
                     version sans cette restriction pour la rendre disponible. -->
                <xpath expr="//field[@name='date_planned']" position="replace"/>
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="date_planned" optional="show"/>
                </xpath>

                <!-- Idem pour date_approve (Date de confirmation) : même blocage
                     column_invisible lié à quotation_only, rendue masquable.
                     Positionnée juste après la colonne "Référence" (name). -->
                <xpath expr="//field[@name='date_approve']" position="replace"/>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="date_approve" optional="show"/>
                </xpath>

                <!-- Colonne Projet après Acheteur (user_id) -->
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="project_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <!-- Vue utilisée par le menu "Commandes" (action purchase_form_action) -->
        <record id="purchase_order_view_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.order.view.tree.inherit</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_ref']" position="replace"/>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="partner_ref" optional="show"/>
                </xpath>
                <xpath expr="//field[@name='date_planned']" position="replace"/>
                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="date_planned" optional="show"/>
                </xpath>

                <!-- Colonne Projet après Acheteur (user_id) -->
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="project_id" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="purchase_order_form_inherit" model="ir.ui.view">
            <field name="name">purchase.order.form</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                    <attribute name="options">{'no_create': true, 'no_open': true}</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="dest_address_id"/>
                </xpath>
                <!-- Analytique par défaut déplacé après "Arrivée prévue", Projet juste après -->
                <xpath expr="//div[@name='date_planned_div']" position="after">
                    <field name="account_analytic_id" options="{'no_create': True, 'no_open': True}"/>
                </xpath>
                <xpath expr="//field[@name='project_id']" position="replace"/>
                <xpath expr="//field[@name='account_analytic_id']" position="after">
                    <field name="project_id"/>
                </xpath>

                <xpath expr="//field[@name='partner_ref']" position="after">
                    <field name="partner_ref_note"/>
                </xpath>

                <xpath expr="//page[1]" position="after">
                    <page string="Technical document">
                        <div>
                            <field name="print_technical_document"/> <label for="print_technical_document"/>
                        </div>
                        <field name="technical_document"/>
                    </page>
                </xpath>
            </field>
        </record>
        
    </data>
</odoo>

