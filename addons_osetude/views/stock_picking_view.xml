    -->
   
    <record id="vpicktree_ref_affaire_inherit" model="ir.ui.view">
        <field name="name">stock.picking.list.ref.affaire.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id" string="Projet" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_picking_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="set_to_draft"
                    string="Set to draft"
                    type="object"
                    class="oe_highlight"
                    invisible="state=='done'" 
                    groups="addons_osetude.group_osetude_set_picking_draft"
                    confirm="Are you sure you want to draft the document?"/>
            </xpath>
            <xpath expr="//label[@for='partner_id']/parent::div" position="before">
                <div class="alert alert-warning" role="alert" colspan="2" invisible="print_deliveryslip_ok or not project_id">
                    deliveryslip non printable (check the project checklist)
                </div>
            </xpath>
            <xpath expr="//field[@name='origin']" position="after">
                <field name="project_id"/>
            </xpath>
            
            <!-- ############################# LE CHAMP NAME N'EST PLUS DANS LA VUE
            <xpath expr="//field[@name='move_ids']/list/field[@name='name']" position="replace"/>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="name" readonly="1"/>
            </xpath>
            -->

            <!-- Colonne "Description" affichée par défaut : nécessaire pour voir le texte
                 repris automatiquement des produits génériques BL (cf. bl_generic_product /
                 _fill_generic_product_delivery_description). Remplacée par le champ
                 description_picking_display (models/stock_move.py) : reste éditable, mais
                 n'affiche/ne réécrit jamais le nom du produit tout seul quand il n'y a
                 aucune description distincte (sinon "Produit" et "Description" affichaient
                 le même texte en double sur l'écran). -->
            <xpath expr="//field[@name='move_ids_without_package']/list/field[@name='description_picking']" position="replace">
                <field name="description_picking_display" string="Description" optional="show"/>
            </xpath>

            <xpath expr="//notebook" position="before">
                <group>
                    <field name="delivery_note"/>
                    <field name="print_deliveryslip_ok" invisible="1"/>
                    <field name="print_satisfaction_ok" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>
   
</odoo>

